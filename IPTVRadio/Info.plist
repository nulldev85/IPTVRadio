<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  IPTV providers vary: many serve station artwork (stream_icon / tvg-logo)
  and some serve streams over plain HTTP. App Transport Security blocks
  those loads by default, which is why provider artwork would not appear.
  Arbitrary loads are therefore enabled for user-configured provider
  endpoints. HTTPS is still preferred and insecure portals are clearly
  warned about at sign-in.
-->
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!--
	  Background audio. Without this iOS suspends the app the moment it leaves
	  the foreground and playback dies with it. This is also declared by the
	  INFOPLIST_KEY_UIBackgroundModes build setting, but it is spelled out here
	  too: it is the single switch the whole feature depends on, and keeping it
	  in the file makes it greppable and reviewable instead of buried in
	  project.pbxproj. Duplicating it is harmless — this file wins, with the
	  same value.
	-->
	<!--
	  One appearance, everywhere. The app is designed against a graphite base
	  (see Theme.swift); this locks UIKit's own chrome — alerts, the keyboard,
	  the search field, the generated launch screen — to it as well, so nothing
	  flashes light on a device set to light mode.
	-->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
